# Copy to .env and fill in real values. Never commit .env.

# --- App ---
# development | test | production. `test` returns the sign-in link to the UI (no email server
# needed) — local use only. `production` requires a real JWT_SECRET.
ENVIRONMENT=development
DEBUG=true

# --- Database (PostgreSQL) ---
# Matches docker-compose.yml defaults (host port 5433 to avoid clashing with a local Postgres on 5432)
DATABASE_URL=postgresql+asyncpg://orchestra:orchestra@localhost:5433/orchestra

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (Ollama Cloud) ---
# For local Ollama: http://localhost:11434 with empty API key.
# For Ollama Cloud: set the cloud base URL + API key.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_PRIMARY_MODEL=glm-5.3-flash:cloud
OLLAMA_FALLBACK_MODEL=glm-5.3-flash:cloud

# --- Auth (magic link + JWT) ---
# MUST be a long random string in production.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
MAGIC_LINK_EXPIRE_MINUTES=15

# --- Email (magic link delivery) ---
# Dev stub logs the link instead of sending it (see app/clients/email.py).
EMAIL_FROM=orchestra@example.com

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Frontend (magic link target) ---
FRONTEND_BASE_URL=http://localhost:5173

# --- Retrieval providers (FR-6) ---
# All optional. A provider without credentials is simply not offered to the
# Retrieval & Evidence Agent. See SETUP.md 4a for how to get each of these.
# MusicBrainz needs no credentials; YouTube Music search is unauthenticated.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
LASTFM_API_KEY=
# Reddit through Composio (no Reddit developer credentials needed). See SETUP.md 4b.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=orchestra-backend
COMPOSIO_REDDIT_CONNECTED_ACCOUNT_ID=
# Playlist export: register this exact URI in the Spotify dashboard (127.0.0.1, not localhost).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback
MUSICBRAINZ_CONTACT=you@example.com

# --- Audio Analysis (FR-3.2/3.4) ---
# Music Flamingo endpoint hosting (Modal/RunPod) is not yet deployed
# (architecture.md §9) — leave unset for now. Absence degrades gracefully:
# no caption, recommendations still run.
MUSIC_FLAMINGO_ENDPOINT_URL=
MUSIC_FLAMINGO_API_KEY=
# Modal proxy token (modal workspace proxy-tokens create); both empty = no edge check on the Modal side
MUSIC_FLAMINGO_PROXY_KEY=
MUSIC_FLAMINGO_PROXY_SECRET=
MUSIC_FLAMINGO_TIMEOUT_SECONDS=600

# --- Observability ---
# Leave empty to disable MLflow tracing. `docker compose up -d mlflow` serves the UI at :5000.
MLFLOW_TRACKING_URI=http://localhost:5000
