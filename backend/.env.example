# Copy to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database (PostgreSQL) ---
# Matches docker-compose.yml defaults (host port 5433 to avoid clashing with a local Postgres on 5432)
DATABASE_URL=postgresql+asyncpg://orchestra:orchestra@localhost:5433/orchestra

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (Ollama Cloud) ---
# For local Ollama: http://localhost:11434 with empty API key.
# For Ollama Cloud: set the cloud base URL + API key.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_PRIMARY_MODEL=kimi-k3:cloud
OLLAMA_FALLBACK_MODEL=deepseek-v4-flash:cloud

# --- Auth (magic link + JWT) ---
# MUST be a long random string in production.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
MAGIC_LINK_EXPIRE_MINUTES=15

# --- Email (magic link delivery) ---
EMAIL_FROM=orchestra@example.com

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]
